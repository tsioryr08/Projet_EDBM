# Dependencies and local configuration
/vendor/
/.env

# CodeIgniter runtime files
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/documents/*
/writable/session/*
/writable/uploads/*

# Keep required directory placeholders and example fixtures
!/writable/cache/index.html
!/writable/debugbar/index.html
!/writable/logs/index.html
!/writable/documents/index.html
!/writable/session/index.html
!/writable/uploads/index.html
!/writable/exemples/
!/writable/exemples/**

# Build and test output
/build/
/coverage/
/tests/coverage/
